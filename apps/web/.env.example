# Created automatically when a Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Required in production for the scheduled cleanup route.
CRON_SECRET=

# Optional. When set, API requests must provide this value in
# x-readydownloader-token. Leave unset for a public deployment.
READYDOWNLOADER_ACCESS_TOKEN=

# Conservative public-service limits.
READYDOWNLOADER_MAX_OUTPUT_MB=500
READYDOWNLOADER_RETENTION_HOURS=24
